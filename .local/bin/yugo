#!/usr/bin/env bash

SESSION="yugo"

case "$1" in
  start)
    echo "🐳 Checking Docker Desktop..."

    # Launch Docker Desktop if not running
    if ! pgrep -xq "Docker Desktop"; then
      echo "🚀 Launching Docker Desktop..."
      open -a "Docker"
      sleep 3
    fi

    # Wait until Docker daemon is ready
    ATTEMPTS=0
    MAX_ATTEMPTS=30
    until docker info >/dev/null 2>&1; do
      ((ATTEMPTS++))
      if [ $ATTEMPTS -ge $MAX_ATTEMPTS ]; then
        echo "❌ Docker did not start after waiting ~30 seconds."
        echo "👉 Please open Docker Desktop manually, wait for it to start, then run: yugo start"
        exit 1
      fi
      echo "⏳ Waiting for Docker to start... ($ATTEMPTS)"
      sleep 1
    done
    echo "✅ Docker daemon is running!"

    echo "🚀 Starting Docker containers..."
    for svc in mysql redis minio inngest; do
      if docker ps -q -f name=$svc >/dev/null 2>&1; then
        echo "✔️  $svc already running."
      elif docker ps -a -q -f name=$svc >/dev/null 2>&1; then
        echo "🔄 Starting $svc..."
        docker start $svc >/dev/null 2>&1 && echo "✔️  $svc started."
      else
        echo "⚠️  $svc container not found. You may need to recreate it."
      fi
    done

    sleep 3

    echo "💻 Launching tmux workspace '$SESSION'..."

    tmux has-session -t $SESSION 2>/dev/null
    if [ $? != 0 ]; then
      echo "Creating new tmux session '$SESSION'..."

      tmux new-session -d -s $SESSION -c ~/projects/yugo
      tmux rename-window -t $SESSION:1 'editor'
      tmux send-keys -t $SESSION:editor 'nvim .' C-m

      tmux new-window -t $SESSION:2 -n 'root' -c ~/projects/yugo
      tmux send-keys -t $SESSION:root 'docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"' C-m

      tmux new-window -t $SESSION:3 -n 'cli' -c ~/projects/yugo/apps/cli
      tmux send-keys -t $SESSION:cli 'clear' C-m

      tmux new-window -t $SESSION:4 -n 'server' -c ~/projects/yugo
      tmux send-keys -t $SESSION:server 'yarn install && yarn build && yarn build && yarn dev' C-m

      # sleep 5
      #
      # tmux new-window -t $SESSION:5 -n 'zrokapp' -c ~/projects/yugo
      # tmux send-keys -t $SESSION:zrokapp 'zrok share reserved kalpeshyugoapp' C-m
      #
      # sleep 5
      #
      # tmux new-window -t $SESSION:6 -n 'zrokapi' -c ~/projects/yugo
      # tmux send-keys -t $SESSION:zrokapi 'zrok share reserved kalpeshyugoapi' C-m
      #
      # tmux new-window -t $SESSION:7 -n 'gemini' -c ~/projects/yugo
      # tmux send-keys -t $SESSION:gemini 'gemini' C-m
    fi

    tmux attach -t $SESSION
    ;;

  stop)
    echo "🛑 Stopping tmux session..."
    tmux kill-session -t $SESSION 2>/dev/null

    echo "🛑 Stopping Docker containers..."
    for svc in mysql redis minio inngest; do
      docker stop $svc >/dev/null 2>&1 && echo "Stopped $svc"
    done
    ;;

  docker)
    docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
    ;;
  generate)
    FILENAME="$2"

    if [ -z "$FILENAME" ]; then
      echo "❌ Migration filename is required"
      echo "👉 Usage: yugo generate <migration-name>"
      exit 1
    fi

    echo "🧬 Generating migration: $FILENAME"

    node ./dist/main.js db migrations:generate ../../migrations/"$FILENAME" --js
    ;;
  run)
    node ./dist/main.js db migrations:run
    ;;
  *)
    echo "Usage: yugo {start|stop|docker|generate filename|run}"
    ;;
esac
